# Vision Sentinel Environment Configuration
# Copy this file to .env and adjust variables as required.

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=180

# Local Computer Vision & Model Settings
# When MODEL_PATH exists and LOCAL_MODEL_ENABLED=true, Mode A runs with ONNX person detector.
# Otherwise, Vision Sentinel seamlessly falls back to Mode B (Classical OpenCV Motion Candidate).
MODEL_PATH=./models/person_detector.onnx
LOCAL_MODEL_ENABLED=true

# Optional Google Gemini Reasoning Provider (Disabled by default)
# Strictly adheres to Free Tier: Never use paid features, never auto-upgrade billing.
# Real user media is NEVER transmitted without explicit per-job consent.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_CALLS_PER_JOB=3
GEMINI_TIMEOUT_SECONDS=15
GEMINI_SEND_USER_MEDIA=false
GEMINI_FREE_TIER_ONLY=true

# AWS Cloud Settings (Zero unauthorized spend)
AWS_STORAGE_ENABLED=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Cloud-Optimized OpenCV Library (COOL)
# Requires verified AWS Graviton Arm environment.
COOL_ENABLED=false
